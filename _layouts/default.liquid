---
layout: tasks/compress
---
{%- include rest/defaults.liquid -%}
{%- include common/rest/defaults.liquid -%}

<!doctype html>
<html lang="{{ lang }}" dir="{{ direction }}">
  <head>
    {%- include common/metadata.liquid -%}
    {%- include common/title.liquid -%}
    {%- include common/twitter_cards.liquid -%}
    {%- include common/opengraph.liquid -%}
    {%- include common/schema.liquid -%}
    {%- include common/google_site_verification.liquid -%}
    {%- include common/links.liquid -%}
    {%- include rest/styles.liquid -%}
    {%- include common/script.liquid -%}
    {%- include extra/head.html -%}
  </head>
  {%- comment -%} 依 front matter 決定側欄狀態：
       autohide_article_chapter_index — 不把本章節結構放進側欄；
       若該頁本身沒有下級結構（根層頁面，如全站主頁）則側欄會變空 → 寬螢幕整條收掉（見 core/sidebar.scss）。 {%- endcomment -%}
  {%- assign layout_cur_page = site_pages | where: "url", page.url | first -%}
  {%- assign layout_cur_srcdir = layout_cur_page.path | remove: layout_cur_page.name | prepend: '/' -%}
  {%- assign sidebar_would_be_empty = false -%}
  {%- if page.autohide_article_chapter_index and layout_cur_srcdir == "/" -%}
    {%- assign sidebar_would_be_empty = true -%}
  {%- endif -%}
  <body class="container{% if page.autohide_article_chapter_index %} autohide-chapter-index{% endif %}{% if sidebar_would_be_empty %} sidebar-hidden{% endif %}">
    {%- include templates/topnav.liquid -%}
    {%- include templates/sidebar.liquid -%}
    {%- include templates/content.liquid -%}
    {%- include extra/body.html -%}
    {%- include rest/script.liquid -%}
    {%- include common/mermaid.liquid -%}
    {%- include common/mathjax.liquid -%}
    {%- include common/google_adsense_gtag.liquid -%}
    {%- include common/analytics_gdpr_compliant.liquid -%}
  </body>
</html>